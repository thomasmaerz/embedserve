[Unit]
Description=Authenticated PyTorch embedding service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=embedserve
Group=embedserve
SupplementaryGroups=video
WorkingDirectory=/opt/embedserve/current
EnvironmentFile=/etc/embedserve/embedserve.env
Environment=HF_HOME=/var/cache/embedserve
Environment=HUGGINGFACE_HUB_CACHE=/var/cache/embedserve/hub
Environment=TOKENIZERS_PARALLELISM=false
Environment=OMP_NUM_THREADS=4
ExecStart=/opt/embedserve/current/.venv/bin/embedserve
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CacheDirectory=embedserve

[Install]
WantedBy=multi-user.target
